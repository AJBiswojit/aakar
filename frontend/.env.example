# AAKAR — environment configuration
# Copy to `.env.local` and adjust. Both values are read through
# src/utils/env.js — never read import.meta.env directly inside components.

# Data source for the service layer: "mock" | "api"
# Only "mock" is implemented in Phase 0/1 (see src/services/index.js).
VITE_DATA_SOURCE=mock

# Base URL of the future backend API (unused while VITE_DATA_SOURCE=mock)
VITE_API_URL=

# Optional: simulated latency for mock services, in milliseconds (default 0).
# Useful for exercising loading states during development.
VITE_MOCK_LATENCY=0

# Optional: set when a hosted preview proxies the dev server over https
# (fixes the HMR websocket port). Leave empty for local development.
VITE_HMR_CLIENT_PORT=
